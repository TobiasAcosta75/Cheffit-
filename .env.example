# Valores de `npx supabase status` (Supabase local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# USDA FoodData Central (DEMO_KEY sirve para la importación inicial)
# (opcional) API de USDA; el seed se genera desde el CSV oficial "SR Legacy" descargado aparte
FDC_API_KEY=DEMO_KEY
# Usuario de desarrollo (lo crea scripts/create-dev-user.ts)
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
# Connection string (Session pooler) para aplicar migraciones con `npx supabase db push`
SUPABASE_DB_URL=
